# Copy this file to .env in the repo root and adjust as needed before running
# `docker-compose up --build -d`. All of these have sane local-dev defaults in
# docker-compose.yaml, so an empty .env (or none at all) still works - this
# file exists mainly to document what's configurable.

# --- Airflow ---
# Linux only: your host UID, so files written by containers aren't root-owned.
# Run `id -u` to get it. Leave unset on macOS/Windows.
AIRFLOW_UID=50000

# Flask session secret for the Airflow webserver. Any random string is fine
# for local dev; use a real generated secret for anything beyond that.
AIRFLOW_WEBSERVER_SECRET_KEY=please-change-this-secret-key-in-your-env-file

# Airflow admin account created by airflow-init on first boot.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Datasets ---
# Where the raw datasets consumed by the stress-testing / ingestion DAGs live
# on your machine (ticker CSVs, UN Comtrade / macroecon dumps, stress-test
# fixtures). These are large and not committed to the repo. Point this at
# wherever you keep them, or leave the default and create the folder locally.
# See backend/datasets/readme.md for the expected subfolder layout.
DATASETS_DIR=./backend/datasets

# --- Backend secrets (not env vars - see below) ---
# The UN Comtrade API key lives in backend/config/uncomtrade-api-key.json,
# not here: copy backend/config/uncomtrade-api-key.example.json to
# backend/config/uncomtrade-api-key.json and fill in your real keys
# (https://comtradedeveloper.un.org/signin).
#
# postgres_db_uri, stress_test_mode and aggregation_stress_mode are Airflow
# Variables, not env vars - set them from the Airflow UI (Admin > Variables)
# or `airflow variables set <key> <value>` inside a container once the stack
# is up.
