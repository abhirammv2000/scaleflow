# Copy this file to frontend/.env.local and fill in real values.
# `npm run dev` / `npm run build` will fail at runtime without these.

# --- Clerk (auth) --- https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Supabase (block/sheet storage) --- Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Pinecone (vector search) --- https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- OpenAI (Q&A synthesis + embeddings) --- https://platform.openai.com
OPENAI_API_KEY=

# --- App ---
# ScaleFlow is currently single-tenant: every sheet is scoped to this one
# organization_id in Supabase. See lib/constants.ts.
DEFAULT_ORG_ID=rc_org_1
