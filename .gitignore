# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Next.js-specific ignores (node_modules, .next/, etc.) live in frontend/.gitignore,
# since the Next.js app root is frontend/, not the repo root.

# OS/editor cruft
.DS_Store
Thumbs.db

# supabase CLI local state (project ref, pooler URL, tool versions)
supabase/.temp/

# real API keys/config - copy the .example version and fill it in locally
backend/config/uncomtrade-api-key.json

# local Airflow runtime output
backend/logs/

# large raw datasets used by the Airflow DAGs - not meant to be committed
# (point DATASETS_DIR in your .env elsewhere if you keep them outside the repo)
backend/datasets/*
!backend/datasets/readme.md
backend/helper_datasets/*.csv

# python
__pycache__/
*.pyc
.venv/
venv/
